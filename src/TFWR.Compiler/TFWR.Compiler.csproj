<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<ProjectReference Include="..\TFWR.Api\TFWR.Api.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.11" />
	</ItemGroup>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.3</Version>
		<Authors>SeongSikChae</Authors>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<RepositoryUrl>https://github.com/SeongSikChae/TFWRCompiler.NET.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/SeongSikChae/TFWRCompiler.NET.git</PackageProjectUrl>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!-- TypeScript frontend bridge (Node + typescript). Copied beside the assembly for lang=ts. -->
	<ItemGroup>
		<Content Include="TsFrontend\lower.mjs">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<Link>TsFrontend\lower.mjs</Link>
		</Content>
		<Content Include="TsFrontend\package.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<Link>TsFrontend\package.json</Link>
		</Content>
		<Content Include="TsFrontend\package-lock.json" Condition="Exists('TsFrontend\package-lock.json')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<Link>TsFrontend\package-lock.json</Link>
		</Content>
		<Content Include="TsFrontend\tfwr.d.ts" Condition="Exists('TsFrontend\tfwr.d.ts')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<Link>TsFrontend\tfwr.d.ts</Link>
		</Content>
		<Content Include="..\TFWR.Api.Ts\tfwr.d.ts" Condition="!Exists('TsFrontend\tfwr.d.ts')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<Link>TsFrontend\tfwr.d.ts</Link>
		</Content>
	</ItemGroup>

	<Target Name="NpmCiTsFrontend" BeforeTargets="Build;Publish" Condition="Exists('TsFrontend\package.json')">
		<Exec Command="npm ci" WorkingDirectory="TsFrontend" Condition="Exists('TsFrontend\package-lock.json')" />
		<Exec Command="npm install" WorkingDirectory="TsFrontend" Condition="!Exists('TsFrontend\package-lock.json')" />
	</Target>

	<Target Name="CopyTsFrontendNodeModules" AfterTargets="NpmCiTsFrontend;Build" BeforeTargets="CopyFilesToOutputDirectory">
		<ItemGroup>
			<_TsNodeModules Include="TsFrontend\node_modules\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(_TsNodeModules)"
		      DestinationFiles="@(_TsNodeModules->'$(OutputPath)TsFrontend\node_modules\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>

	<Target Name="PublishTsFrontendNodeModules" AfterTargets="Publish" Condition="Exists('TsFrontend\node_modules')">
		<ItemGroup>
			<_TsNodeModulesPublish Include="TsFrontend\node_modules\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(_TsNodeModulesPublish)"
		      DestinationFiles="@(_TsNodeModulesPublish->'$(PublishDir)TsFrontend\node_modules\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>

</Project>
